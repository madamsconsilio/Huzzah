    \}\
\
    \cf8 public\cf2  \cf8 async\cf2  Task<\cf13 string\cf2 > \cf12 CallClaudeAsync\cf2 (\cf13 string\cf2  userPrompt, \cf13 string\cf2  documentText)\
    \{\
