        \cf8 protected\cf2  \cf8 void\cf2  \cf12 btnRunClaude_Click\cf2 (\cf13 object\cf2  sender, EventArgs e)\
        \{\
            RegisterAsyncTask(\cf8 new\cf2  PageAsyncTask(ExecuteClaudeWorkflowAsync));\
        \}\
\
        \cf8 private\cf2  \cf8 async\cf2  Task \cf12 ExecuteClaudeWorkflowAsync\cf2 ()\
        \{\
            \cf8 if\cf2  (\cf13 string\cf2 .IsNullOrEmpty(ddlDynamicOptions.SelectedValue) || \cf13 string\cf2 .IsNullOrEmpty(ddlFields.SelectedValue))\
            \{\
                lblStatus.Text = \cf10 "Please select both a Folder and a Target Field."\cf2 ;\
                lblStatus.ForeColor = System.Drawing.Color.Red;\
                \cf8 return\cf2 ;\
            \}\
\
            \cf13 int\cf2  selectedFolderId = \cf13 int\cf2 .Parse(ddlDynamicOptions.SelectedValue);\
            \cf13 int\cf2  selectedFieldArtifactId = \cf13 int\cf2 .Parse(ddlFields.SelectedValue);\
            \cf13 string\cf2  targetFieldName = ddlFields.SelectedItem.Text;\
            \cf13 string\cf2  userPrompt = txtUserPrompt.Text;\
\
            lblStatus.Text = \cf10 "Querying documents and invoking Claude..."\cf2 ;\
            lblStatus.ForeColor = System.Drawing.Color.Blue;\
\
            IServicesMgr servicesMgr = ConnectionHelper.Helper().GetServicesManager();\
            \cf8 using\cf2  (IObjectManager objectManager = servicesMgr.CreateProxy<IObjectManager>(ExecutionIdentity.CurrentUser))\
            \{\
                \cf15 // 1. Query documents in the selected folder (sample top 5 docs for example)\cf2 \
                \cf8 var\cf2  docQuery = \cf8 new\cf2  QueryRequest\
                \{\
                    ObjectType = \cf8 new\cf2  ObjectTypeRef \{ ArtifactTypeID = \cf7 10\cf2  \}, \cf15 // 10 = Document\cf2 \
                    Condition = \cf10 $"'Folder' == OBJECT \cf14 \{selectedFolderId\}\cf10 "\cf2 ,\
                    Fields = \cf8 new\cf2  List<FieldRef>\
                    \{\
                        \cf8 new\cf2  FieldRef \{ Name = \cf10 "Control Number"\cf2  \},\
                        \cf8 new\cf2  FieldRef \{ Name = \cf10 "Extracted Text"\cf2  \}\
                    \}\
                \};\
\
                QueryResult docResults = \cf8 await\cf2  objectManager.QueryAsync(WorkspaceArtifactId, docQuery, \cf7 1\cf2 , \cf7 5\cf2 );\
\
                \cf8 if\cf2  (docResults == \cf7 null\cf2  || !docResults.Objects.Any())\
                \{\
                    lblStatus.Text = \cf10 "No documents found in the selected folder."\cf2 ;\
                    lblStatus.ForeColor = System.Drawing.Color.Orange;\
                    \cf8 return\cf2 ;\
                \}\
\
                \cf8 var\cf2  claude = \cf8 new\cf2  ClaudeApiClient(ClaudeApiKey);\
                \cf8 var\cf2  logs = \cf8 new\cf2  StringBuilder();\
\
                \cf15 // 2. Loop documents, send to Claude, and update the chosen field\cf2 \
                \cf8 foreach\cf2  (RelativityObject doc \cf8 in\cf2  docResults.Objects)\
                \{\
                    \cf13 string\cf2  controlNum = doc.FieldValues.Find(f => f.Field.Name == \cf10 "Control Number"\cf2 )?.Value?.ToString() ?? doc.ArtifactID.ToString();\
                    \cf13 string\cf2  extractedText = doc.FieldValues.Find(f => f.Field.Name == \cf10 "Extracted Text"\cf2 )?.Value?.ToString() ?? \cf13 string\cf2 .Empty;\
\
                    \cf15 // Truncate text if large to fit token limits\cf2 \
                    \cf8 if\cf2  (extractedText.Length > \cf7 8000\cf2 ) extractedText = extractedText.Substring(\cf7 0\cf2 , \cf7 8000\cf2 ) + \cf10 "... [truncated]"\cf2 ;\
\
                    \cf15 // 3. Call Claude\cf2 \
                    \cf13 string\cf2  response = \cf8 await\cf2  claude.CallClaudeAsync(userPrompt, extractedText);\
                    logs.AppendLine(\cf10 $"[\cf14 \{controlNum\}\cf10 ] -> Claude Result: \cf14 \{response\}\cf10 \\n"\cf2 );\
\
                    \cf15 // 4. Update the selected field on the document\cf2 \
                    \cf8 var\cf2  updateRequest = \cf8 new\cf2  UpdateRequest\
                    \{\
                        Object = \cf8 new\cf2  RelativityObjectRef \{ ArtifactID = doc.ArtifactID \},\
                        FieldValues = \cf8 new\cf2  List<FieldRefValuePair>\
                        \{\
                            \cf8 new\cf2  FieldRefValuePair\
                            \{\
                                Field = \cf8 new\cf2  FieldRef \{ ArtifactID = selectedFieldArtifactId \},\
                                Value = response\
                            \}\
                        \}\
                    \};\
\
                    \cf8 await\cf2  objectManager.UpdateAsync(WorkspaceArtifactId, updateRequest);\
                \}\
\
                lblStatus.Text = \cf10 $"Successfully processed \cf14 \{docResults.Objects.Count\}\cf10  document(s)."\cf2 ;\
                lblStatus.ForeColor = System.Drawing.Color.Green;\
                litClaudeResponse.Text = logs.ToString();\
                divOutput.Visible = \cf7 true\cf2 ;\
            \}\
        \}\
\
        \cf7 #\cf8 endregion\cf2 \
    \}\
\}}