\
        \cf8 var\cf2  requestMessage = \cf8 new\cf2  HttpRequestMessage(HttpMethod.Post, \cf10 "https://api.anthropic.com/v1/messages"\cf2 )\
        \{\
            Content = \cf8 new\cf2  StringContent(JsonConvert.SerializeObject(requestPayload), Encoding.UTF8, \cf10 "application/json"\cf2 )\
        \};\
\
        requestMessage.Headers.Add(\cf10 "x-api-key"\cf2 , _apiKey);\
        requestMessage.Headers.Add(\cf10 "anthropic-version"\cf2 , \cf10 "2023-06-01"\cf2 );\
\
        HttpResponseMessage response = \cf8 await\cf2  _httpClient.SendAsync(requestMessage);\
        \cf13 string\cf2  responseBody = \cf8 await\cf2  response.Content.ReadAsStringAsync();\
\
        \cf8 if\cf2  (!response.IsSuccessStatusCode)\
        \{\
